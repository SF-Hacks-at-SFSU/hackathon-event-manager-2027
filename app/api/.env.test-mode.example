# Safe local/staging configuration for testing decisions and QR scanning.
# Copy these values into the API environment; this file is never loaded automatically.

# Decision buttons render the real template but do not change application status.
APPLICATION_STATUS_MODE=test

# Optional: set this to your own inbox to test real SES delivery.
# Leave blank to perform a no-send dry run.
APPLICATION_STATUS_TEST_EMAIL=

# QR scans validate the participant but do not set checked_in/checked_in_at.
CHECKIN_MODE=test

# Replace with a long random secret. Use the same value in test API instances.
CHECKIN_QR_SECRET=replace-with-at-least-32-random-characters
