DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
PARTICIPANT_PORTAL_URL=https://app.sfhacks.io/dashboard
SUPABASE_SERVICE_ROLE_KEY=
BACKEND_PORT=4000
RESEND_API_KEY=
RESEND_FROM_ADDRESS="SF Hacks <onboarding@resend.dev>"
ORGANIZER_NOTIFICATION_EMAIL=sfhacksteam@gmail.com
ADMIN_PORTAL_URL=https://admin.sfhacks.io/dashboard/applications
# Status decisions default to test mode. In test mode, application records are not changed.
# Set a test recipient to send real test messages; leave blank for a no-send dry run.
APPLICATION_STATUS_MODE=test
APPLICATION_STATUS_TEST_EMAIL=
# Check-in defaults to validation-only test mode. Set live only on event day.
CHECKIN_MODE=test
# Long random secret used to sign event-specific QR passes.
CHECKIN_QR_SECRET=
# comma-separated extra origins allowed to call the API in addition to the three portals on 3000-3002
ADDITIONAL_CORS_ORIGINS=
